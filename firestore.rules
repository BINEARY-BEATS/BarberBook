rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isDemoId(id) {
      return id.matches('demo_.*');
    }
    function isParticipant() {
      return signedIn() &&
        request.auth.uid in resource.data.participantIds;
    }
    function isParticipantOnCreate() {
      return signedIn() &&
        request.auth.uid in request.resource.data.participantIds;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    // Shop profiles are public for discovery.
    // Demo catalog docs (demo_shop_*) can be written by any signed-in demo user.
    match /barbers/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) || (signedIn() && isDemoId(uid));
    }

    match /appointments/{id} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.barberId == request.auth.uid ||
        resource.data.isDemo == true ||
        isDemoId(resource.data.barberId) ||
        isDemoId(resource.data.customerId)
      );
      allow create: if signedIn() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.barberId == request.auth.uid ||
        request.resource.data.isDemo == true
      );
      allow update, delete: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.barberId == request.auth.uid ||
        resource.data.isDemo == true
      );
    }

    match /queue/{barberId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /portfolio/{id} {
      allow read: if true;
      allow create: if signedIn() && (
        request.resource.data.barberId == request.auth.uid ||
        isDemoId(request.resource.data.barberId) ||
        request.resource.data.isDemo == true
      );
      allow update, delete: if signedIn() && (
        resource.data.barberId == request.auth.uid ||
        isDemoId(resource.data.barberId) ||
        resource.data.isDemo == true
      );
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && (
        request.resource.data.customerId == request.auth.uid ||
        isDemoId(request.resource.data.barberId) ||
        request.resource.data.isDemo == true
      );
      allow update, delete: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        isDemoId(resource.data.barberId) ||
        resource.data.isDemo == true
      );
    }

    match /conversations/{id} {
      allow read: if isParticipant();
      allow create: if isParticipantOnCreate() &&
        request.resource.data.participantIds.size() == 2;
      allow update: if isParticipant();

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participantIds;
        allow create: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
